// Example who-to-meet: MATCH path=(me:Person {id:'me'})-[:INTERESTED_IN]->(t:Topic)<-[:INTERESTED_IN]-(p:Person) RETURN p.name, collect(t.name) AS shared ORDER BY size(shared) DESC;
