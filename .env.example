# Server-side only. Never commit real values. Leave FALKORDB_URL empty
# and the app ranks on an in-memory graph built from the seed snapshot.
# FalkorDB Cloud uses falkors:// (TLS) and a non-standard port. The app
# parses that URL and connects with TLS. The URL is never logged.

FALKORDB_URL=
FALKOR_GRAPH=copilot_seed

# Optional. POST /api/seed requires Authorization: Bearer <SEED_TOKEN>.
# The app still loads the catalog on its own when the graph is empty.
SEED_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Cap on live /api/agent calls per UTC day, per server instance.
# Missing, blank, or invalid values fall back to 800.
DAILY_AI_BUDGET_CALLS=800

BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=

# Live scrapes and sends stay off in the public demo.
SENDING_ENABLED=false
